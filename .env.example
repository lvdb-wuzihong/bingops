# ─── 应用配置 ────────────────────────────────────────────────────────────────
BINGOPS_DEBUG=false
BINGOPS_LOG_LEVEL=INFO
# 日志文件输出目录（空=不落盘，仅 stdout）；配置后按天轮转 + gzip 压缩，供采集器读取
BINGOPS_LOG_DIR=
# 日志文件保留天数（0=永久保留）
BINGOPS_LOG_RETENTION_DAYS=7

# ─── 数据库 ───────────────────────────────────────────────────────────────────
# PostgreSQL 连接（asyncpg 驱动）
BINGOPS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bingops

# ─── Redis ─────────────────────────────────────────────────────────────────────
BINGOPS_REDIS_URL=redis://localhost:6379
BINGOPS_REDIS_PASSWORD= 
BINGOPS_REDIS_DB=0

# ─── JWT 认证 ─────────────────────────────────────────────────────────────────
# 生产环境必须替换为随机字符串（openssl rand -hex 32）
BINGOPS_SECRET_KEY=change-me-in-production
BINGOPS_ACCESS_TOKEN_EXPIRE_MINUTES=15
BINGOPS_REFRESH_TOKEN_EXPIRE_DAYS=7
BINGOPS_JWT_ALGORITHM=HS256

# ─── 飞书 SSO ─────────────────────────────────────────────────────────────────
# 从飞书开放平台获取，不配置则飞书登录不可用
BINGOPS_FEISHU_APP_ID=
BINGOPS_FEISHU_APP_SECRET=
BINGOPS_FEISHU_REDIRECT_URI=http://localhost:8000/api/v1/auth/feishu/callback

# ─── Kafka（CMDB 资源同步）─────────────────────────────────────────────────────
# 总开关：false 时启动不拉起 Kafka 消费者
BINGOPS_KAFKA_ENABLED=true
# Kafka 集群地址（同一集群多 Broker 用逗号分隔）
BINGOPS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Consumer Group（多实例共用同一 group 并行消费）
BINGOPS_KAFKA_CONSUMER_GROUP=bingops-cmdb
# Topic 匹配模式（前缀需与生产端写入的 topic 名一致）
BINGOPS_KAFKA_K8S_TOPIC_PATTERN=k8s-events-{cluster_id}
BINGOPS_KAFKA_CLOUD_TOPIC_PATTERN=cloud-sync-{provider}
# 实际订阅的 Topic 列表（逗号分隔，可选项）：
# 留空 = 默认按 pattern 正则订阅 ^(k8s-events-.*|cloud-sync-.*)，新集群 topic 自动发现，
# 无需改配置重启；处理与否由数据库 cmdb_sync_tasks 控制（同步任务页面启停）。
# 仅在需要精确限定订阅范围时才显式配置。
BINGOPS_KAFKA_K8S_TOPICS=
BINGOPS_KAFKA_CLOUD_TOPICS=

# ─── 种子数据 ─────────────────────────────────────────────────────────────────
# init_data.py 创建默认 admin 用户时使用的密码
BINGOPS_ADMIN_PASSWORD=admin123456
